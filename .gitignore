# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.eggs/
*.egg-info/

# Secrets / config local
.env
config/*.local.yaml

# OS
.DS_Store
Thumbs.db

# Crawl output: giữ cấu trúc thư mục nhưng không commit data nặng.
# Bỏ comment các dòng dưới nếu KHÔNG muốn commit data crawl:
# raw_data/output/**/raw/*
# raw_data/output/**/features/*
!raw_data/output/**/.gitkeep

# Log phản hồi thô của model (dựng lại được bằng cách chạy lại extract_llm.py)
raw_data/output/**/_llm_log/

# Log tiến trình batch (run_all.sh / run_batch.sh) — chỉ có giá trị trong lúc chạy
raw_data/output/**/_batch_*.log
raw_data/output/**/_batch_*.out
raw_data/output/**/_proxy_*.log

# Proxy runtime
code_proxy/runtime/
code_proxy/proxy.log
